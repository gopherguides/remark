{
  package parser

  import (
      "fmt"
      "unicode"
      "io"
  )
}

DOC <- EOL stmts:(HEADER / HR)+ EOF {
  return newNodes(c, stmts)
}

HEADER <- level:( "#"+ ) text:( PARAGRAPH ) EOL ps:(PARAGRAPH )* {
  return newHeader(c, level, text, ps)
}

PARAGRAPH <- !( HEADER / HR ) stmts:( BOLD / TEXT)+ EOL{
return newParagraph(c, stmts)
}


BOLD <-  "**" [^\n]+ "**"  {
fmt.Println(c)
return newString(c), nil
}

/* TEXT <- [^\n]+ !BOLD { */
TEXT <- [^\n]+  {
return newString(c), nil
}

HR <- ( "---" / "- - -" / "___") EOL? {
return newHR(c)
}

EOL ← _ [\n]* {
  return nil, nil
}

_ "whitespace" ← [ \t]* {
  return nil, nil
}

EOF <- !. {
  return nil, nil
}
