{
  package parser

  import (
      "fmt"
      "unicode"
      "io"
  )
}

DOC <- EOL stmts:( HEADER / PARAGRAPH )+ EOF {
  return newNodes(c, stmts)
}

HEADER <- level:("#"+) _ text:([^\n]+) EOL {
  return newHeader(c, level, text)
}

PARAGRAPH <- text:([^#^ ^\t]+) EOL {
  return newParagraph(c, text)
}

EOL ← _ [\n]* {
  return nil, nil
}

_ "whitespace" ← [ \t]* {
  return nil, nil
}

EOF <- !. {
  return nil, nil
}
